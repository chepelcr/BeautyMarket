# Pollo Porteño storefront — environment example.
# These variables are only consumed at build time. The deployed
# storefront also reads `/config.json` (preferred) for its organizationId.

VITE_API_URL=https://api.tsuru.jcampos.dev

# AWS Amplify / Cognito (anonymous guest user)
VITE_AWS_REGION=us-east-1
VITE_AWS_COGNITO_USER_POOL_ID=
VITE_AWS_COGNITO_CLIENT_ID=
VITE_AWS_COGNITO_IDENTITY_POOL_ID=

# Optional fallback if /config.json is missing.
VITE_ORGANIZATION_ID=
