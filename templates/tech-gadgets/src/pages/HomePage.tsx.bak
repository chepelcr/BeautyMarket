import { Link } from 'wouter';
import { Cpu, Smartphone, Laptop, Headphones, Watch, Zap } from 'lucide-react';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
import { useProducts, useHomePage } from '@/hooks/useContent';
import { parsePageSections, getSectionByType } from '@/lib/pageUtils';
export default function HomePage() {
  const { data: pageData } = useHomePage();
  const sections = parsePageSections(pageData);
  const hero = getSectionByType(sections, 'hero')?.content || {};
  const benefits = getSectionByType(sections, 'benefits')?.content || {};
  const cta = getSectionByType(sections, 'cta')?.content || {};
  const { data: products = [], isLoading } = useProducts();
import { parsePageSections, getSectionByType } from '@/lib/pageUtils';  const featuredProducts = products.slice(0, 4);

  return (
    <div className="min-h-screen bg-background text-foreground">
      <Navbar cartItemCount={0} />

      {/* Hero Section */}
      <section className="relative overflow-hidden grid-pattern scanlines">
        <div className="container-tech py-24 relative z-10">
          <div className="max-w-3xl">
            <h2 className="text-5xl md:text-6xl font-bold mb-6 text-tech-shadow">
              The Future of
              <span className="block mt-2 animated-gradient-text">
                Technology
              </span>
            </h2>
            <p className="text-xl text-muted-foreground mb-8">
              Discover cutting-edge gadgets and premium electronics. From smartphones to smart home devices,
              we bring you the latest innovations in technology.
            </p>
            <div className="flex gap-4">
              <Link href="/products">
                <button className="btn-tech-accent">
                  Explore Products
                </button>
              </Link>
              <button className="btn-tech-secondary">
                View Deals
              </button>
            </div>
          </div>
        </div>

        {/* Decorative elements */}
        <div className="absolute top-20 right-10 w-64 h-64 bg-tech-cyan/10 rounded-full blur-3xl" />
        <div className="absolute bottom-20 left-10 w-80 h-80 bg-tech-electric/10 rounded-full blur-3xl" />
      </section>

      {/* Featured Categories */}
      <section className="container-tech py-16">
        <h3 className="section-header-tech">Browse by Category</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {categories.map((category) => (
            <Link key={category.name} href={`/category/${category.slug}`}>
              <div className="card-tech group cursor-pointer">
                <div className="flex items-center space-x-4 mb-4">
                  <div className="p-3 bg-tech-electric/10 rounded-sm group-hover:bg-tech-cyan/20 transition-colors">
                    <category.icon className="h-8 w-8 text-tech-cyan" />
                  </div>
                  <div>
                    <h4 className="text-xl font-semibold group-hover:text-tech-cyan transition-colors">
                      {category.name}
                    </h4>
                    <p className="text-sm text-muted-foreground">{category.count} products</p>
                  </div>
                </div>
                <p className="text-muted-foreground">{category.description}</p>
              </div>
            </Link>
          ))}
        </div>
      </section>

      {/* Featured Products */}
      <section className="container-tech py-16 bg-card/50">
        <h3 className="section-header-tech">Featured Tech</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {isLoading ? (
            Array(4).fill(0).map((_, i) => <div key={i} className="card-tech animate-pulse h-80" />)
          ) : (
            featuredProducts.map((product: any) => (
              <Link key={product.id} href={`/products/${product.id}`}>
                <div className="card-tech group cursor-pointer">
                  <div className="aspect-square bg-background rounded-sm mb-4 overflow-hidden">
                    <div className="w-full h-full flex items-center justify-center tech-gradient-subtle group-hover:tech-gradient transition-all">
                      <Cpu className="h-20 w-20 text-tech-cyan opacity-50 group-hover:opacity-100 transition-opacity" />
                    </div>
                  </div>
                  <h4 className="font-semibold mb-2 group-hover:text-tech-cyan transition-colors">
                    {product.name}
                  </h4>
                  <p className="text-sm text-muted-foreground mb-3">{product.description}</p>
                  <div className="flex items-center justify-between">
                    <span className="text-2xl font-bold text-tech-cyan">${product.price}</span>
                    {product.badge && (
                      <span className="px-3 py-1 bg-accent/20 text-accent rounded-sm text-xs font-medium">
                        {product.badge}
                      </span>
                    )}
                  </div>
                </div>
              </Link>
            ))
          )}
        </div>
      </section>

      {/* Tech Specs Section */}
      <section className="container-tech py-16">
        <div className="tech-gradient rounded-sm p-12 text-center">
          <h3 className="text-4xl font-bold mb-4 text-white">
            Premium Technology, Guaranteed
          </h3>
          <p className="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
            All products come with official warranty, free shipping, and 30-day returns.
            Experience the future of technology today.
          </p>
          <button className="px-8 py-4 bg-white text-primary rounded-sm font-bold hover:bg-white/90 transition-colors">
            Learn More
          </button>
        </div>
      </section>

      <Footer />
    </div>
  );
}

const categories = [
  {
    name: 'Smartphones',
    slug: 'smartphones',
    icon: Smartphone,
    count: 124,
    description: 'Latest flagship phones and accessories',
  },
  {
    name: 'Laptops',
    slug: 'laptops',
    icon: Laptop,
    count: 87,
    description: 'High-performance laptops and ultrabooks',
  },
  {
    name: 'Audio',
    slug: 'audio',
    icon: Headphones,
    count: 156,
    description: 'Premium headphones and speakers',
  },
  {
    name: 'Wearables',
    slug: 'wearables',
    icon: Watch,
    count: 64,
    description: 'Smartwatches and fitness trackers',
  },
  {
    name: 'Computing',
    slug: 'computing',
    icon: Cpu,
    count: 203,
    description: 'Desktop PCs and components',
  },
  {
    name: 'Smart Home',
    slug: 'smart-home',
    icon: Zap,
    count: 98,
    description: 'Connected home devices and automation',
  },
];


